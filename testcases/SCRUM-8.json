    "id": "SCRUM-8-TC-12",
    "title": "Price validation - Line item total updates with quantity changes",
    "type": "automated",
    "priority": "medium",
    "preconditions": "",
    "steps": [
      {
        "step": "Add product with price $10.00 to cart with quantity 1",
        "expected": "Line total = $10.00"
      },
      {
        "step": "Navigate to cart page",
        "expected": "Cart loads with product"
      },
      {
        "step": "Increase quantity to 5",
        "expected": "Line total = $50.00"
      },
      {
        "step": "Verify calculation is correct",
        "expected": "$10.00 × 5 = $50.00"
      },
      {
        "step": "Decrease quantity to 2",
        "expected": "Line total = $20.00"
      },
      {
        "step": "Verify calculation is correct",
        "expected": "$10.00 × 2 = $20.00"
      }
    ],
